# Configurações da API PyNFe
# Copie este arquivo para `api/.env` e preencha os valores.

# Aplicação
APP_NAME=PyNFe API
VERSION=1.0.0
DEBUG=false

# Rate limiting
RATELIMIT_ENABLED=true

# Banco de dados (PostgreSQL assíncrono)
DATABASE_URL=postgresql+asyncpg://usuario:senha@localhost:5432/pynfe
DATABASE_POOL_SIZE=5

# KV (Upstash Redis / Vercel KV)
KV_URL=redis://localhost:6379
KV_TOKEN=troque-pelo-token-do-kv

# Vercel Blob
BLOB_READ_WRITE_TOKEN=troque-pelo-token-do-blob

# JWT
JWT_SECRET=troque-por-um-segredo-forte
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
API_KEY_PREFIX=pynfe

# Criptografia (chave Fernet: 32 bytes em base64)
FERNET_KEY=base64-de-32-bytes-aqui

# SEFAZ
SEFAZ_TIMEOUT=28

# Logging
LOG_LEVEL=INFO
